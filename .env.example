# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Server
PORT=8000

# Redis
REDIS_URL=redis://localhost:6379/0

# Postgres
DATABASE_URL=postgresql://wms:wms@localhost:5432/wms

# Session signing (web chat widget) — generate with: python -c "import secrets; print(secrets.token_hex(32))"
# MUST be replaced with a strong random value in production; do not reuse this placeholder.
SESSION_SIGNING_KEY=replace_me_with_a_random_64_char_hex_value

# Chatbox link-gate token signing — generate with: python -c "import secrets; print(secrets.token_hex(32))"
# MUST be replaced with a strong random value in production; do not reuse this placeholder.
CHATBOX_TOKEN_SIGNING_KEY=replace_me_with_a_random_64_char_hex_value

# Public origin this app is reachable at once deployed (e.g. a Cloud Run
# *.run.app URL, or a custom domain). Used to build absolute links — like the
# campus map image — that get echoed into chat replies. Leave unset locally.
PUBLIC_BASE_URL=

# Daily message cap (cost/abuse guard on /chat) — optional, defaults to 50/day
# per user. Override per school via daily_message_cap in data/schools/<id>/school.json.
# DEFAULT_DAILY_MESSAGE_CAP=50

# Comma-separated session ids exempt from the daily cap (staff/testing accounts).
# A session id is only known after a user's first /chat request (it's embedded
# in their signed wms_session cookie) — pull it from server logs to whitelist it.
# DAILY_CAP_WHITELIST=
