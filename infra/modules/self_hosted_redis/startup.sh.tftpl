#!/bin/bash
set -euo pipefail

# Runs on every VM boot. Two paths:
#   * First-boot only: install Docker, install snapshot timer + Ops Agent,
#     drop the marker file.
#   * Every boot: fetch latest Redis AUTH password from Secret Manager and
#     write it to the systemd EnvironmentFile the redis-container unit
#     reads. This way a password rotation is "add new Secret Manager
#     version + reboot" with no manual VM access needed.
#
# Redis itself runs in the official `redis:7-alpine` container, not the
# Debian package. This avoids the systemd sandbox + apt-postinst quirks we
# hit with the packaged version, and pins the Redis version explicitly.

MARKER=/var/lib/wms-chatbot-redis-installed
export DEBIAN_FRONTEND=noninteractive

REDIS_IMAGE="redis:7-alpine"
DATA_DIR=/var/lib/redis-data
PASSWORD_ENV=/etc/redis/password.env

# ── First-boot install (idempotent, gated by marker) ───────────────────────
if [ ! -f "$MARKER" ]; then
  apt-get update
  apt-get install -y docker.io
  systemctl enable docker
  systemctl start docker

  # Pre-pull the Redis image so the systemd unit doesn't have to wait on a
  # slow first-time image pull inside ExecStart (which can time out).
  docker pull "$REDIS_IMAGE"

  mkdir -p "$DATA_DIR"
  mkdir -p /etc/redis
fi

# ── Persistent data disk mount (every boot — idempotent) ──────────────────
# /dev/disk/by-id/google-redis-data is stable — comes from the attached_disk
# block's device_name. First boot after attach: disk is empty, mkfs.ext4.
# On subsequent boots (or fresh VMs attaching an existing disk): disk is
# already formatted, fstab entry gets added, systemd auto-mounts.
#
# CRITICAL for the initial migration on a live VM: this script will mount
# the (empty) disk on top of $DATA_DIR, MASKING any existing data. Copy
# the old data OFF the boot disk BEFORE the first reset with this script
# active. See docs/self-hosted-redis.md for the migration runbook.
DATA_DEV=/dev/disk/by-id/google-redis-data
if [ -b "$DATA_DEV" ]; then
  # Format if blank. blkid returns non-zero on unformatted block devices.
  if ! blkid "$DATA_DEV" >/dev/null 2>&1; then
    mkfs.ext4 -F -L redis-data "$DATA_DEV"
  fi

  DATA_UUID=$(blkid -s UUID -o value "$DATA_DEV")

  # Add fstab entry if missing (idempotent — won't add duplicates).
  # `discard` (TRIM) + `noatime` are standard for persistent disks on GCE.
  if ! grep -q "UUID=$${DATA_UUID}" /etc/fstab; then
    echo "UUID=$${DATA_UUID} $${DATA_DIR} ext4 discard,defaults,noatime 0 2" >> /etc/fstab
  fi

  # Mount if not already mounted.
  if ! mountpoint -q "$DATA_DIR"; then
    mount "$DATA_DIR"
  fi

  chown -R 999:999 "$DATA_DIR"
fi

# ── Every boot: fetch password from Secret Manager + write EnvironmentFile ─
PASSWORD=$(gcloud secrets versions access latest \
  --secret=${password_secret_id} \
  --project=${project_id})

# EnvironmentFile format — no quotes around the value, no spaces. Mode 600
# so only root can read it (Docker daemon runs as root and passes the env
# to the container).
umask 077
cat >"$PASSWORD_ENV" <<EOF
REDIS_PASSWORD=$${PASSWORD}
EOF
umask 022

# ── Redis container systemd unit (rewritten on every boot so config
#     changes propagate cleanly) ─────────────────────────────────────────
cat >/etc/systemd/system/wms-redis-container.service <<EOF
[Unit]
Description=Redis (official $${REDIS_IMAGE} container)
Requires=docker.service
After=docker.service network-online.target

[Service]
Restart=always
RestartSec=5
EnvironmentFile=$${PASSWORD_ENV}
TimeoutStartSec=120
# --rm cleans up the container on stop; --name pins the container name so
# ExecStop and the snapshot timer can find it. --network=host publishes
# 6379 on the VM's network directly (simpler than -p mapping, and the
# firewall already gates access).
ExecStartPre=-/usr/bin/docker rm -f wms-redis
ExecStart=/usr/bin/docker run --rm --name wms-redis --network=host \\
  -v $${DATA_DIR}:/data \\
  $${REDIS_IMAGE} \\
  redis-server \\
    --requirepass \$${REDIS_PASSWORD} \\
    --bind 0.0.0.0 \\
    --save 300 1 --save 60 100 \\
    --maxmemory ${redis_maxmemory} --maxmemory-policy allkeys-lru \\
    --dir /data --dbfilename dump.rdb \\
    --loglevel notice
ExecStop=/usr/bin/docker stop -t 30 wms-redis

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable wms-redis-container.service
systemctl restart wms-redis-container.service

# ── First-boot only from here down ─────────────────────────────────────────
if [ -f "$MARKER" ]; then
  systemctl restart wms-redis-snapshot.timer || true
  exit 0
fi

# ── GCS snapshot timer ─────────────────────────────────────────────────────
# Every ${snapshot_interval}: BGSAVE inside the running Redis container,
# wait for it to finish, copy dump.rdb from the host bind-mount to GCS,
# then prune to the ${snapshot_retention_count} most recent snapshots.
cat >/usr/local/bin/wms-redis-snapshot.sh <<SNAPSHOT_EOF
#!/bin/bash
set -euo pipefail
BUCKET="${gcs_bucket}"
RETENTION=${snapshot_retention_count}

PASSWORD=\$(gcloud secrets versions access latest \\
  --secret=${password_secret_id} --project=${project_id})

docker exec wms-redis \\
  redis-cli -a "\$PASSWORD" --no-auth-warning BGSAVE >/dev/null

# Wait for the background save to finish.
for _ in \$(seq 1 30); do
  STATUS=\$(docker exec wms-redis redis-cli -a "\$PASSWORD" --no-auth-warning \\
    INFO persistence | tr -d '\r' | awk -F: '/rdb_bgsave_in_progress/ {print \$2}')
  if [ "\$STATUS" = "0" ]; then
    break
  fi
  sleep 1
done

DATE=\$(date -u +%Y-%m-%d-%H%M%S)
gsutil -q cp $${DATA_DIR}/dump.rdb "gs://\$BUCKET/dump-\$DATE.rdb"

# Retention: keep the newest N snapshots, delete the rest.
mapfile -t OLD < <(gsutil ls "gs://\$BUCKET/dump-*.rdb" 2>/dev/null | sort | head -n -"\$RETENTION")
if [ "\$${#OLD[@]}" -gt 0 ]; then
  gsutil -q rm "\$${OLD[@]}"
fi
SNAPSHOT_EOF
chmod +x /usr/local/bin/wms-redis-snapshot.sh

cat >/etc/systemd/system/wms-redis-snapshot.service <<EOF
[Unit]
Description=Snapshot Redis dump.rdb to GCS
Wants=wms-redis-container.service
After=wms-redis-container.service network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/wms-redis-snapshot.sh
EOF

cat >/etc/systemd/system/wms-redis-snapshot.timer <<EOF
[Unit]
Description=Run wms-redis-snapshot every ${snapshot_interval}

[Timer]
OnBootSec=2min
OnUnitActiveSec=${snapshot_interval}
Persistent=true

[Install]
WantedBy=timers.target
EOF

systemctl daemon-reload
systemctl enable --now wms-redis-snapshot.timer

# ── DBSIZE reporter (feeds the self_hosted_redis_dbsize log-based metric) ──
# Runs redis-cli DBSIZE every 60s, writes "dbsize=<N>" to syslog via
# `logger`. Cloud Logging picks up syslog (Ops Agent's log pipeline is
# reliable in this project even when its metric pipeline isn't), and the
# monitoring module extracts the number as a distribution metric that a
# dashboard tile plots as "current key count".
cat >/usr/local/bin/wms-redis-dbsize.sh <<'DBSIZE_EOF'
#!/bin/bash
set -euo pipefail
PASSWORD=$(cat /etc/redis/password.env | cut -d= -f2)
DBSIZE=$(docker exec wms-redis redis-cli -a "$PASSWORD" --no-auth-warning DBSIZE 2>/dev/null || echo -1)
logger -t wms-redis-metrics "dbsize=$DBSIZE"
DBSIZE_EOF
chmod +x /usr/local/bin/wms-redis-dbsize.sh

cat >/etc/systemd/system/wms-redis-dbsize.service <<EOF
[Unit]
Description=Report Redis DBSIZE to syslog (feeds the wms_chatbot/self_hosted_redis_dbsize log-based metric)
Wants=wms-redis-container.service
After=wms-redis-container.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/wms-redis-dbsize.sh
EOF

cat >/etc/systemd/system/wms-redis-dbsize.timer <<EOF
[Unit]
Description=Run wms-redis-dbsize every 60s

[Timer]
OnBootSec=30s
OnUnitActiveSec=60s
Persistent=true

[Install]
WantedBy=timers.target
EOF

systemctl daemon-reload
systemctl enable --now wms-redis-dbsize.timer

# ── Google Cloud Ops Agent ─────────────────────────────────────────────────
# Ships VM metrics (CPU, memory, disk, uptime) + system logs to Cloud
# Monitoring / Logging.
curl -sSO https://dl.google.com/cloudagents/add-google-cloud-ops-agent-repo.sh
bash add-google-cloud-ops-agent-repo.sh --also-install --version=latest

touch "$MARKER"
