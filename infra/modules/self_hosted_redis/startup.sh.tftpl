#!/bin/bash
set -euo pipefail

# Compute Engine startup scripts run on every boot, not just first. Split the
# work into two paths:
#   * First-boot only: install packages, install snapshot timer + Ops Agent,
#     drop the marker file.
#   * Every boot: fetch latest Redis AUTH password from Secret Manager,
#     rewrite /etc/redis/redis.conf, restart Redis.
# This way a password rotation is "add new Secret Manager version + reboot"
# with no manual VM access needed.

MARKER=/var/lib/wms-chatbot-redis-installed
export DEBIAN_FRONTEND=noninteractive

# ── First-boot install (idempotent, gated by marker) ───────────────────────
if [ ! -f "$MARKER" ]; then
  apt-get update
  apt-get install -y redis-server google-cloud-cli
  mkdir -p /var/redis
  chown redis:redis /var/redis
fi

# ── Every boot: fetch password from Secret Manager + write redis.conf ─────
# `gcloud secrets versions access latest` requires network + the VM SA to
# have roles/secretmanager.secretAccessor on the secret (granted by
# Terraform). --format='get(payload.data)' + base64 decode returns raw
# bytes without gcloud's trailing newline gotcha.
PASSWORD=$(gcloud secrets versions access latest \
  --secret=${password_secret_id} \
  --project=${project_id})

# Redis config. Rewritten on every boot to pick up password changes.
# - bind 0.0.0.0 is safe here: only IPs that can reach us are the VPC
#   connector's /28, enforced by the firewall rule. Redis is unreachable
#   from the public internet.
# - requirepass adds AUTH on top: defense-in-depth if the firewall ever
#   opens up or someone else lands a VM in the connector CIDR.
# - protected-mode off is required alongside bind 0.0.0.0; the firewall +
#   requirepass are the real access controls.
# - RDB (save 300 1) + AOF (appendonly yes) both on: RDB gives cheap point-
#   in-time snapshots for the GCS backup path, AOF gives durability between
#   snapshots so a VM crash loses at most a second of writes.
# - maxmemory + allkeys-lru: caps Redis at ${redis_maxmemory} and evicts
#   oldest keys under memory pressure. Given usage is ~5 MB, this is defense-
#   in-depth against a runaway leak, not a day-to-day limit.
cat >/etc/redis/redis.conf <<EOF
bind 0.0.0.0 -::*
protected-mode no
port 6379
requirepass $${PASSWORD}
maxmemory ${redis_maxmemory}
maxmemory-policy allkeys-lru
dir /var/redis
dbfilename dump.rdb
save 300 1
save 60 100
appendonly yes
appendfilename appendonly.aof
supervised systemd
loglevel notice
logfile /var/log/redis/redis-server.log
EOF
chmod 640 /etc/redis/redis.conf
chown root:redis /etc/redis/redis.conf

systemctl enable redis-server
systemctl restart redis-server

# ── First-boot only from here down ─────────────────────────────────────────
if [ -f "$MARKER" ]; then
  # Already installed the timer + Ops Agent; nothing else to do.
  systemctl restart wms-redis-snapshot.timer || true
  exit 0
fi

# ── GCS snapshot timer ─────────────────────────────────────────────────────
# Every ${snapshot_interval}: BGSAVE inside Redis (non-blocking snapshot),
# wait for it to finish, copy /var/redis/dump.rdb to GCS with a timestamp,
# then prune to the ${snapshot_retention_count} most recent.
cat >/usr/local/bin/wms-redis-snapshot.sh <<SNAPSHOT_EOF
#!/bin/bash
set -euo pipefail
BUCKET="${gcs_bucket}"
RETENTION=${snapshot_retention_count}

# BGSAVE needs the AUTH password now.
PASSWORD=\$(gcloud secrets versions access latest \\
  --secret=${password_secret_id} --project=${project_id})
redis-cli -a "\$PASSWORD" --no-auth-warning BGSAVE >/dev/null

# Wait for the background save to finish.
for _ in \$(seq 1 30); do
  STATUS=\$(redis-cli -a "\$PASSWORD" --no-auth-warning INFO persistence \\
    | tr -d '\r' | awk -F: '/rdb_bgsave_in_progress/ {print \$2}')
  if [ "\$STATUS" = "0" ]; then
    break
  fi
  sleep 1
done

DATE=\$(date -u +%Y-%m-%d-%H%M%S)
gsutil -q cp /var/redis/dump.rdb "gs://\$BUCKET/dump-\$DATE.rdb"

# Retention: keep the newest N snapshots, delete the rest.
mapfile -t OLD < <(gsutil ls "gs://\$BUCKET/dump-*.rdb" 2>/dev/null | sort | head -n -"\$RETENTION")
if [ "\$${#OLD[@]}" -gt 0 ]; then
  gsutil -q rm "\$${OLD[@]}"
fi
SNAPSHOT_EOF
chmod +x /usr/local/bin/wms-redis-snapshot.sh

cat >/etc/systemd/system/wms-redis-snapshot.service <<EOF
[Unit]
Description=Snapshot Redis dump.rdb to GCS
Wants=redis-server.service
After=redis-server.service network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/wms-redis-snapshot.sh
EOF

cat >/etc/systemd/system/wms-redis-snapshot.timer <<EOF
[Unit]
Description=Run wms-redis-snapshot every ${snapshot_interval}

[Timer]
OnBootSec=15min
OnUnitActiveSec=${snapshot_interval}
Persistent=true

[Install]
WantedBy=timers.target
EOF

systemctl daemon-reload
systemctl enable --now wms-redis-snapshot.timer

# ── Google Cloud Ops Agent ─────────────────────────────────────────────────
# Ships VM metrics (CPU, memory, disk, uptime) + system logs to Cloud
# Monitoring / Logging so the monitoring module can chart + alert.
curl -sSO https://dl.google.com/cloudagents/add-google-cloud-ops-agent-repo.sh
bash add-google-cloud-ops-agent-repo.sh --also-install --version=latest

touch "$MARKER"
