# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtual environment
.venv/
venv/
env/

# Environment variables
.env
*.env

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# User data — never commit
data/feedback.jsonl

# Local Claude Code instructions and settings — never commit
CLAUDE.md
.claude/

# Local design docs — never commit
docs/production_plan.md

# Promotional flyer assets (local working files, not app code) — never commit
marketing/

# Database
*.db
*.sqlite3

# Jupyter
.ipynb_checkpoints/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
# tfvars can hold non-secret env config or secret overrides — the checked-in
# .example is the source of truth; everything else stays local.
infra/**/terraform.tfvars
infra/**/*.auto.tfvars
!infra/**/terraform.tfvars.example
# Modules get their own ephemeral lock files during CI validate runs; only
# root modules (envs/*) carry the canonical lock we all init against.
infra/modules/**/.terraform.lock.hcl

# Lunch-menu day-maps (scripts/parse_lunch_menu.py --day-map input) are
# hand-written scratch files a human recreates fresh each month from that
# month's calendar PDF — the final parsed output in data/lunch_menus/
# already carries everything durable (including manual overrides, which
# are documented in scripts/lunch_menu_day_maps/README.md instead).
scripts/lunch_menu_day_maps/*.json
